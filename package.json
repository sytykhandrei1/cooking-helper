{
  "name": "cooking-helper",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "description": "Помощник выбора домашних блюд",
  "homepage": "https://cooking-helper.asytykh.workers.dev/",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-native",
    "build": "npm run export:web",
    "check": "npm run quality && npm test && npm run build",
    "deploy": "npm run check && wrangler deploy",
    "git:identity": "sh scripts/check-git-identity.sh",
    "test": "vitest run",
    "quality": "node scripts/check-dishes.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "expo": "~57.0.19",
    "expo-blur": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.0"
  }
}
